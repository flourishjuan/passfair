{
  "expo": {
    "name": "Passfair",
    "slug": "passfair",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "passfair",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "ai.agentsfair.passfair",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Passfair uses Face ID to protect your saved API keys.",
        "NSPhotoLibraryUsageDescription": "Choose photos and videos for your agents to look at.",
        "NSCameraUsageDescription": "Take a photo or video for your agents to look at.",
        "NSMicrophoneUsageDescription": "Record sound with a video you send to your agents."
      }
    },
    "android": {
      "package": "ai.agentsfair.passfair",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your agents to look at.",
          "cameraPermission": "Take a photo or video for your agents to look at.",
          "microphonePermission": "Record sound with a video you send to your agents."
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      "expo-iap",
      "./plugins/with-background-run"
    ],
    "extra": {
      "eas": {
        "projectId": "e50b0df4-8eba-4101-b8f7-5a91178cc9db"
      }
    }
  }
}
